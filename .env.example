# Jvalyx Backend Environment Configuration

# Replay Timing Compression
# ~2 scenario-minutes of observation time per real second of playback
JVALYX_REPLAY_COMPRESSION=120
JVALYX_REPLAY_MAX_GAP_SECONDS=6

# Inference Mode: 'catboost' (trained model artifact) or 'stub' (deterministic demo)
JVALYX_INFERENCE=catboost

# NASA FIRMS MAP_KEY for the backend (https://firms.modaps.eosdis.nasa.gov/api/map_key).
# Keeps data/live_cache/firms_history.sqlite current, which the v3 model's
# recurrence_days_90d feature is computed from. Without it, history only advances with
# detections the live map sends, and fires past the synced range route UNCERTAIN.
# Don't put a real key in a tracked .env.
FIRMS_MAP_KEY=

# Persistent Local Database (SQLite WAL-mode)
JVALYX_DB_PATH=data/jvalyx_audit.db

# Offshore / Cloud Database Audit Replication
# Supports BOTH:
# 1. Native PostgreSQL (Supabase direct URI, Neon, AWS RDS, TimescaleDB):
#    OFFSHORE_DB_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
#
# 2. Cloud REST API / Supabase PostgREST Webhook:
#    OFFSHORE_DB_URL=https://[project-ref].supabase.co
#    OFFSHORE_DB_KEY=[supabase-anon-or-service-key]
OFFSHORE_DB_URL=
OFFSHORE_DB_KEY=

# ---- Docker deployment (docker-compose.prod.yml) ---------------------------
# Public hostname; its DNS A record must point at the server. Caddy fetches the
# TLS certificate automatically and serves the API under https://$DOMAIN/api.
DOMAIN=
# Required by the prod overlay; the bundled Postgres refuses the dev default there.
POSTGRES_PASSWORD=
# Extra comma-separated CORS origins (not needed when served same-origin via Caddy).
JVALYX_CORS_ORIGINS=
# Frontend build args — inlined into the public JS bundle.
VITE_FIRMS_MAP_KEY=
VITE_CARTO_API_KEY=

